@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 17
skinparam shadowing false
skinparam monochrome true
hide footbox
' Solid filled call arrows and dashed return arrows follow the course notation.
' Keep notes beside lifelines so activation bars stay visible.
participant "command:\nSetDietCommand" as C
participant "planner:\nDietaryPlanner" as P
participant "generator:\nMealPlanGenerator" as G
[-> C : execute(...)
activate C
C -> P : repair(...)
activate P
note left of P : Count conflicting days;\nretain daily targets.
P -> P : generate(...)
activate P
note left of P : Filter eligible recipes.
P -> G : generate(...)
activate G
G --> P : replacementPlan
deactivate G
P --> P : replacementPlan
deactivate P
note left of P : Reuse compatible days;\nreplace conflicting days.
P --> C : updatedPlan
deactivate P
note right of C : Continue in\n"Updating groceries\nand saving the result".
deactivate C
@enduml
