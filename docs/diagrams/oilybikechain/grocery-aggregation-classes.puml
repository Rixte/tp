@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Grocery aggregation values
top to bottom direction
skinparam nodesep 35
skinparam ranksep 55
hide empty members

class GroceryListGenerator {
  + generateForPlan(plan: MealPlan): List<GroceryItem>
  + generate(ingredients: List<GroceryItem>): List<GroceryItem>
}
class "GroceryListGenerator.ItemKey" as ItemKey <<record>> {
  - name: String
  - unit: String
}
class GroceryItem {
  - name: String
  - quantity: BigDecimal
  - unit: String
}

GroceryListGenerator ..> ItemKey : creates temporary keys
GroceryListGenerator ..> GroceryItem : reads and creates
GroceryListGenerator ..> MealPlan : reads planned meals

legend bottom
  Only feature-relevant members are shown.
endlegend
@enduml
