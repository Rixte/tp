@startuml
!pragma layout smetana
!include ../rixte/shortfall/style.iuml
hide circle

title Grocery source and snapshot model
top to bottom direction
skinparam nodesep 30
skinparam ranksep 35
skinparam defaultFontSize 16
hide empty members

class ActiveMealPlan
class MealPlan
class DayPlan
class PlannedMeal {
  - portionCount: int
}
class Recipe
class GroceryItem {
  - name: String
  - quantity: BigDecimal
  - unit: String
}

ActiveMealPlan -down-> "0..1" MealPlan : -plan
ActiveMealPlan --> "0..*" GroceryItem : -groceryList
MealPlan -down-> "0..*" DayPlan : -days
DayPlan -down-> "0..*" PlannedMeal : -plannedMeals
PlannedMeal -down-> "1" Recipe : -recipe
PlannedMeal --> "0..*" GroceryItem : -customizedIngredients
Recipe --> "1..*" GroceryItem : -ingredients
DayPlan -[hidden]right-> GroceryItem

legend bottom
  Collections preserve order and allow repeated references.
  Only source/snapshot fields are shown; traversal is expanded separately.
endlegend
@enduml
