' Shared visual settings for the record-meal diagrams.
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #475569
skinparam LineColor #475569
skinparam classAttributeIconSize 0
hide circle
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #475569
skinparam componentBackgroundColor #F5F8FC
skinparam componentBorderColor #475569
skinparam participantBackgroundColor #F5F8FC
skinparam participantBorderColor #475569
skinparam sequenceLifeLineBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #FFFFFF
skinparam sequenceGroupBorderColor #94A3B8
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #C4AC70
skinparam maxMessageSize 240
hide footbox
