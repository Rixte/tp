@startuml
!include style.iuml
title Executing view-meals with a non-empty log

participant ":MishMash" as App
participant "cmd:ViewMealsCommand" as Command
participant "mealLog:MealLog" as Log
participant "viewer:MealLogViewer" as Viewer

App -> Command : executeWithResult(recipeBook)
activate Command
Command -> Log : getMeals()
activate Log
Log --> Command : meals
deactivate Log
create Viewer
Command -> Viewer : MealLogViewer()
activate Viewer
deactivate Viewer
Command -> Log : getTotals()
activate Log
Log --> Command : totals
deactivate Log
Command -> Viewer : view(meals, totals)
activate Viewer
Viewer --> Command : text
deactivate Viewer
Command --> App : result
deactivate Command
Viewer -[hidden]-> App
destroy Viewer
Command -[hidden]-> App
destroy Command

note over Command, Log
  result is a CommandResult holding the text and an info status.
  With an empty log the command returns a note status with "No meals
  recorded yet." without creating a viewer.
end note
@enduml
